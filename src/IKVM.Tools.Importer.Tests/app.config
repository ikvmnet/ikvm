<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        The .NET Framework test host ships its own binding redirect for this
        assembly, in testhost.net472.exe.config:

          <bindingRedirect oldVersion="1.0.0.0-10.0.0.0" newVersion="10.0.0.0" />

        along with a 10.0.0.0 copy of its own. IKVM.CoreLib is built against
        8.0.0.0, and the copy that lands beside the tests comes from CoreLib's
        output, so it is 8.0.0.0 as well. Left alone, the host redirects the
        reference up to 10.0.0.0 and the bind fails on major version.

        AutoGenerateBindingRedirects only emits 0.0.0.0-8.0.0.0 here, because
        8.0.0.0 is the highest version anything resolves to, which is too narrow
        to cover the host's range. Widening it to 10.0.0.0 while keeping the
        target at 8.0.0.0 points the bind back at the assembly that is actually
        present.
      -->
      <dependentAssembly>
        <assemblyIdentity name="System.Collections.Immutable" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="8.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
