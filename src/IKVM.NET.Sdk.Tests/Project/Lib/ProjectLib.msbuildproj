<Project>
    <Import Sdk="IKVM.NET.Sdk" Version="$(PackageVersion)" Project="Sdk.props" />

    <PropertyGroup>
        <TargetFrameworks>net472;net48;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
        <RootNamespace>project.lib</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="ProjectLibMetadataKey" Value="ProjectLibMetadataValue" />
    </ItemGroup>

    <Import Sdk="IKVM.NET.Sdk" Version="$(PackageVersion)" Project="Sdk.targets" />
</Project>
