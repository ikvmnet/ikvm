<!--

    openjdk.buildtools.targets

    Imports the OpenJDK build tools as executables into this project. The tools are compiled once for the whole build
    by src/IKVM.OpenJdk.BuildTools, whatever the target framework or runtime of the project running them.

-->

<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
        <JdkBuildToolsProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\src\IKVM.OpenJdk.BuildTools\IKVM.OpenJdk.BuildTools.msbuildproj'))</JdkBuildToolsProject>
    </PropertyGroup>

    <!-- Referenced so the project is restored with this one. It is built by BuildJdkBuildTools, never by the reference. -->
    <ItemGroup>
        <ProjectReference Include="$(JdkBuildToolsProject)" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" Targets="GetTargetPath" />
    </ItemGroup>

    <!--
    Builds the tools and sets JdkBuildToolsOutputPath and JdkBuildToolsStampFile to their location. The properties
    particular to this project are removed, so that every project builds the same instance of the tools project.
    -->
    <Target Name="BuildJdkBuildTools">
        <MSBuild Projects="$(JdkBuildToolsProject)" Targets="GetJdkBuildTools" BuildInParallel="$(BuildInParallel)" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks;RuntimeIdentifier;Platform;SelfContained;PublishDir;PublishUrl;_IsPublishing;$(_GlobalPropertiesToRemoveFromProjectReferences)">
            <Output TaskParameter="TargetOutputs" ItemName="_JdkBuildTools" />
        </MSBuild>

        <PropertyGroup>
            <JdkBuildToolsOutputPath>@(_JdkBuildTools)</JdkBuildToolsOutputPath>
            <JdkBuildToolsStampFile>@(_JdkBuildTools->'%(StampFile)')</JdkBuildToolsStampFile>
        </PropertyGroup>

        <Error Text="Could not locate the OpenJDK build tools." Condition=" '$(JdkBuildToolsOutputPath)' == '' Or !Exists('$(JdkBuildToolsOutputPath)') " />
    </Target>

</Project>
